{
  "extends": [
    "config:recommended",
    "github>canonical/inference-snaps-dev//renovate/default.jsonc#v2"
  ],
  "packageRules": [
    {
      "description": "Automerge runtime updates with lab tests",
      "matchDepNames": [
        "canonical/llama.cpp-builds",
        "openvinotoolkit/model_server"
